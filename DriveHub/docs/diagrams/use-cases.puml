@startuml
!pragma layout smetana
title DriveHub — Casi d'uso (specifica manuale)
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor User
actor Customer
actor Salesman
actor Manager
User <|-- Customer
User <|-- Salesman
User <|-- Manager

rectangle DriveHub {
  usecase "UC-AUTH-01\nRegistrare account" as Register
  usecase "UC-AUTH-02\nAccedere" as Login
  usecase "UC-AUTH-03\nTerminare sessione" as Logout

  usecase "UC-CAT-01\nConsultare catalogo" as Catalog
  usecase "UC-TD-01\nPrenotare test drive" as BookTD
  usecase "UC-RENT-01\nNoleggiare veicolo" as Rent
  usecase "UC-RENT-02\nVedere/annullare noleggi" as MyRentals
  usecase "UC-SALE-01\nRiservare/acquistare" as Sale
  usecase "UC-ACQ-01\nProporre veicolo" as Sell
  usecase "UC-PAY-01\nProcessare pagamento" as Pay

  usecase "UC-TD-02\nGestire test drive" as ManageTD
  usecase "UC-RENT-03\nGestire noleggi" as ManageRent
  usecase "UC-ACQ-02\nFormulare offerta" as Offer
  usecase "UC-INV-01\nGestire inventario" as Inventory

  usecase "UC-DASH-01\nConsultare dashboard" as Dashboard
  usecase "UC-STOCK-01\nOrdinare nuovi veicoli" as Stock
  usecase "UC-PRICE-01\nGestire prezzi/promozioni" as Pricing
  usecase "UC-ACQ-03\nDecidere proposta" as Approve
}

User -- Register
User -- Login
User -- Logout
Customer -- Catalog
Customer -- BookTD
Customer -- Rent
Customer -- MyRentals
Customer -- Sale
Customer -- Sell
Salesman -- ManageTD
Salesman -- ManageRent
Salesman -- Offer
Salesman -- Inventory
Manager -- Dashboard
Manager -- Stock
Manager -- Pricing
Manager -- Approve

Rent ..> Pay : <<include>>
Sale ..> Pay : <<include>>
BookTD ..> Catalog : <<extend>>\n[veicolo selezionato]
Rent ..> Catalog : <<extend>>\n[RENTAL]
Sale ..> Catalog : <<extend>>\n[FOR_SALE]

note bottom
  Diagramma redatto manualmente dalla specifica.
  I dettagli e le alternative sono in USE_CASE_TEMPLATES.md.
end note
@enduml
